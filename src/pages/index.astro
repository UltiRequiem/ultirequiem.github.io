---
import Base from "../layouts/Base.astro";
import Spark from "../components/Spark.astro";
import catalog from "../data/catalog.json";

const { owner, totals, libraries, plugins } = catalog;
const number = new Intl.NumberFormat("en");
const compact = new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 });
const updated = new Date(catalog.generatedAt).toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const name = owner.name ?? owner.login;

interface Listed {
  name: string;
  description: string;
  language: string | null;
  url: string;
  npm: { name: string } | null;
}

const published = libraries.filter((item) => (item.npm?.downloads ?? 0) > 0);
const board = published.slice(0, 8);
const onBoard = new Set(board.map((item) => item.name));
const others = libraries.filter((item) => !onBoard.has(item.name));
const top = board[0]?.npm?.downloads ?? 1;
const npmUrl = (item: Listed) => (item.npm ? `https://www.npmjs.com/package/${item.npm.name}` : item.url);
const haystack = (item: Listed) => `${item.name} ${item.description} ${item.language ?? ""}`.toLowerCase();
---

<Base title={`${name} · open source JavaScript modules`} description={`${totals.packages} open source JavaScript packages by ${name}, installed ${number.format(totals.downloads)} times a month on npm. Typed and ESM-only.`}>
  <div class="wrap">
    <header class="top">
      <a class="brand" href="/"><i></i>{owner.login}</a>
      <nav class="links" aria-label="Profiles">
        <a href={`https://github.com/${owner.login}`}>GitHub</a>
        <a href={`https://www.npmjs.com/~${owner.login.toLowerCase()}`}>npm</a>
      </nav>
    </header>

    <section class="hero">
      <div>
        <h1>{name}</h1>
        <p class="lede">
          I write small JavaScript and TypeScript libraries and publish them on npm. They are open source, fully typed
          and ESM-only, so the same import works in Node.js, Bun and the browser.
        </p>
      </div>

      <div class="panel">
        <div class="panel-top">
          <div class="big">
            <span data-count={totals.downloads}>{number.format(totals.downloads)}</span>
            <small>npm installs of these packages in the last 30 days</small>
          </div>
          <div class="facts">
            <div class="fact"><b>{totals.packages}</b><span>open source packages</span></div>
            <div class="fact"><b>{number.format(totals.stars)}</b><span>GitHub stars across them</span></div>
          </div>
        </div>
        <div class="chart"><Spark values={totals.dailyTotal} width={1000} height={130} strokeWidth={2.2} label="Combined daily npm downloads over the last 30 days" /></div>
        <div class="axis"><span>30 days ago</span><span>today</span></div>
        <p class="note">Only the open source JavaScript packages listed below, not everything I have built.</p>
      </div>
    </section>
  </div>

  <div class="controls">
    <div class="wrap">
      <input class="search" id="search" type="search" placeholder="Search modules…" aria-label="Search modules" />
      <div class="chips" role="group" aria-label="Filter by type">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
        <button class="chip" type="button" data-filter="library" aria-pressed="false">Libraries</button>
        <button class="chip" type="button" data-filter="plugin" aria-pressed="false">Editor plugins</button>
      </div>
    </div>
  </div>

  <main class="wrap">
    {
      board.length > 0 && (
        <section data-section>
          <div class="heading">
            <h2>Most installed</h2>
            <p>Ranked by npm downloads, last 30 days</p>
          </div>
          <ol class="board">
            {board.map((item, index) => (
              <li data-kind="library" data-text={haystack(item)}>
                <a class="row" href={npmUrl(item)} style={`--share:${Math.max(6, Math.round(((item.npm?.downloads ?? 0) / top) * 100))}%`}>
                  <span class="rank">{String(index + 1).padStart(2, "0")}</span>
                  <span class="who">
                    <b>{item.name}</b>
                    <span>{item.description}</span>
                  </span>
                  <Spark values={item.npm?.daily ?? []} width={160} height={40} />
                  <span class="num">
                    <b>{compact.format(item.npm?.downloads ?? 0)}</b>
                    <span>per month</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      others.length > 0 && (
        <section data-section>
          <div class="heading">
            <h2>More libraries</h2>
            <p>{others.length} small modules</p>
          </div>
          <div class="grid">
            {others.map((item) => (
              <a class="card" href={npmUrl(item)} data-kind="library" data-text={haystack(item)}>
                <div class="head">
                  <h3>{item.name}</h3>
                  {item.npm?.version ? <span class="pill">v{item.npm.version}</span> : <span class="pill soon">coming to npm</span>}
                </div>
                {item.description && <p>{item.description}</p>}
                <div class="foot">
                  {item.npm && item.npm.downloads > 0 && <span><b>{compact.format(item.npm.downloads)}</b> / mo</span>}
                  <span>★ {item.stars}</span>
                  {item.npm && item.npm.daily.length > 1 && <Spark values={item.npm.daily} width={64} height={22} />}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      plugins.length > 0 && (
        <section data-section>
          <div class="heading">
            <h2>Editor plugins</h2>
            <p>coc.nvim extensions</p>
          </div>
          <div class="grid">
            {plugins.map((item) => (
              <a class="card" href={npmUrl(item)} data-kind="plugin" data-text={haystack(item)}>
                <div class="head">
                  <h3>{item.name}</h3>
                  {item.npm?.version && <span class="pill">v{item.npm.version}</span>}
                </div>
                {item.description && <p>{item.description}</p>}
                <div class="foot">
                  {item.npm && item.npm.downloads > 0 && <span><b>{compact.format(item.npm.downloads)}</b> / mo</span>}
                  <span>★ {item.stars}</span>
                  {item.npm && item.npm.daily.length > 1 && <Spark values={item.npm.daily} width={64} height={22} />}
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <p class="empty" id="empty" hidden>Nothing matches that search.</p>
  </main>

  <footer class="wrap">
    <span>Numbers come from npm and GitHub and refresh every day · last update {updated}</span>
  </footer>

  <script is:inline>
    const search = document.getElementById("search");
    const chips = [...document.querySelectorAll(".chip")];
    const items = [...document.querySelectorAll("[data-kind]")];
    const sections = [...document.querySelectorAll("[data-section]")];
    const empty = document.getElementById("empty");
    let kind = "all";

    function apply() {
      const query = search.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const match = (kind === "all" || item.dataset.kind === kind) && (!query || item.dataset.text.includes(query));
        item.hidden = !match;
        if (match) shown++;
      }
      for (const section of sections) section.hidden = !section.querySelector("[data-kind]:not([hidden])");
      empty.hidden = shown > 0;
    }

    search.addEventListener("input", apply);
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        kind = chip.dataset.filter;
        for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
        apply();
      });
    }

    // count the headline number up once, unless the visitor prefers less motion
    const counter = document.querySelector("[data-count]");
    if (counter && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const target = Number(counter.dataset.count);
      const start = performance.now();
      const format = new Intl.NumberFormat("en");
      const tick = (now) => {
        const t = Math.min((now - start) / 1100, 1);
        counter.textContent = format.format(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  </script>
</Base>
