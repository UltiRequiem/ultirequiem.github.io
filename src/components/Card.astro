---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";

type Lang = ComponentProps<typeof Code>["lang"];

interface Props {
  item: {
    name: string;
    repo: string;
    kind: string;
    description: string;
    stars: number;
    language: string | null;
    homepage: string | null;
    url: string;
    npm: { name: string; version: string; downloads: number } | null;
    install: string | null;
    usage: { lang: string; code: string } | null;
  };
  showUsage?: boolean;
}

const { item, showUsage = true } = Astro.props;
const number = new Intl.NumberFormat("en", { notation: "compact" });
---

<article class="card" data-kind={item.kind} data-text={`${item.name} ${item.description} ${item.language ?? ""}`.toLowerCase()}>
  <div class="head">
    <h3><a href={item.npm ? `https://www.npmjs.com/package/${item.npm.name}` : item.url}>{item.name}</a></h3>
    {item.npm && <span class="pill">v{item.npm.version}</span>}
  </div>
  {item.description && <p>{item.description}</p>}
  {
    item.install && (
      <div class="install">
        <code>{item.install}</code>
        <button class="copy" type="button" data-copy={item.install} aria-label={`Copy ${item.install}`}>Copy</button>
      </div>
    )
  }
  {
    showUsage && item.usage && (
      <div class="usage">
        <Code code={item.usage.code} lang={item.usage.lang as Lang} themes={{ light: "github-light", dark: "github-dark" }} defaultColor={false} />
      </div>
    )
  }
  <div class="meta">
    {item.npm && <span title="npm downloads, last 30 days">↓ {number.format(item.npm.downloads)}/mo</span>}
    <span>★ {item.stars}</span>
    {item.language && <span>{item.language}</span>}
    <span class="sp">
      <a href={item.url}>GitHub</a>
      {item.homepage && <a href={item.homepage}>{item.kind === "app" ? "Live" : "Docs"}</a>}
    </span>
  </div>
</article>
